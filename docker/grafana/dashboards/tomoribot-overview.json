          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tomoribot-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\",\n       NULLIF((fields->>'pool_last_lifetime_phase_s')::int, -1) AS phase_s\nFROM metric_samples\nWHERE metric_name = 'host_memory' AND $__timeFilter(created_at)\nORDER BY created_at",
          "refId": "A"
        }
      ],
      "description": "Process uptime folded into POSTGRES_MAX_LIFETIME_SECONDS, because Bun exposes no per-connection age. Points clustering at one height mean the pool was created in a burst and retires as a synchronised cohort, which is what would justify a driver level fix; a scattered band means age is not what drives retirement. The -1 sentinel (no lifetime retirement in that interval) is filtered out, so gaps here are the normal state."
    }
