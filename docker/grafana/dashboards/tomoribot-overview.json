            "fillOpacity": 0,
            "showPoints": "always",
            "spanNulls": false,
            "pointSize": 6
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
