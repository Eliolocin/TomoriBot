{
  "annotations": {
    "list": []
  },
  "description": "Health, usage and memory overview for a TomoriBot deployment. Reads only tables that exist in every install, so it works self-hosted and in the cloud alike.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "type": "timeseries",
      "title": "Process Memory",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tomoribot-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tomoribot-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\",\n       (fields->>'heap_used_mb')::float     AS heap_used_mb,\n       (fields->>'external_mb')::float      AS external_mb,\n       (fields->>'array_buffers_mb')::float AS array_buffers_mb\nFROM metric_samples\nWHERE metric_name = 'cache_sizes' AND $__timeFilter(created_at)\nORDER BY created_at",
          "refId": "A"
        }
      ],
      "description": "Heap, external and ArrayBuffer growth. External and array_buffers are native allocations that no cache counter decomposes, so this is the panel that separates a real leak from cache growth."
    },
    {
      "type": "timeseries",
      "title": "Cache Entries (lazy-expiry watchlist)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tomoribot-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tomoribot-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\",\n       (fields->>'channelWhitelist')::int AS \"channelWhitelist\",\n       (fields->>'shortTermMemory')::int  AS \"shortTermMemory\",\n       (fields->>'userCache')::int        AS \"userCache\",\n       (fields->>'tomoriState')::int      AS \"tomoriState\"\nFROM metric_samples\nWHERE metric_name = 'cache_sizes' AND $__timeFilter(created_at)\nORDER BY created_at",
          "refId": "A"
        }
      ],
      "description": "These four expire lazily on read, so an entry whose key is never read again is never removed: the TTL bounds staleness, not size. A monotonic climb here is the signature."
    },
    {
      "type": "timeseries",
      "title": "Errors per Hour by Type",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tomoribot-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tomoribot-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'),\n       error_type AS metric,\n       count(*)   AS value\nFROM error_logs\nWHERE $__timeFilter(created_at)\nGROUP BY 1, error_type\nORDER BY 1",
          "refId": "A"
        }
      ],
      "description": "Requires ERROR_DB_LOGGING_ENABLED. A flat line during a suspected incident may mean the repository's circuit breaker is open, not that errors stopped."
    },
