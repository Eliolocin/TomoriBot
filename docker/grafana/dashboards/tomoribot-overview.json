          "rawQuery": true,
          "rawSql": "SELECT\n  bucket AS \"time\",\n  metric_key AS metric,\n  SUM(count) AS value\nFROM stat_counters\nWHERE metric IN ('tokens_in', 'tokens_out')\n  AND bucket >= CURRENT_DATE - INTERVAL '30 days'\nGROUP BY bucket, metric_key\nORDER BY bucket;",
