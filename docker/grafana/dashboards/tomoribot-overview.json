    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tomoribot-postgres"
      },
      "description": "Tomori's mood cloud: combined emotion breakdown mirroring /stats generate persona affinity: tagged emojis (emoji_used joined to server_emojis.emotion_key), tagged stickers (sticker_used joined to server_stickers.emotion_key), and non-identity sprites (sprite_emotion). Global across all servers.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "x": 6,
        "y": 34,
        "w": 6,
        "h": 6
      },
      "options": {
        "series_index": 0,
        "tokenization": false,
        "wordCloudOptions": {
          "deterministic": true,
          "enableTooltip": true,
          "fontFamily": "arial",
          "fontSizes": [15, 80],
          "padding": 1,
          "rotationAngles": [0, 0],
          "rotations": 2,
          "scale": "sqrt",
          "spiral": "archimedean",
          "transitionDuration": 800
        }
      },
      "pluginVersion": "1.2.11",
      "targets": [
        {
          "dataset": "tomoribot",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tomoribot-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT emotion_key AS \"word\", LN(SUM(cnt)) AS \"metric\"\nFROM (\n  SELECT se.emotion_key AS emotion_key, sc.count AS cnt\n  FROM stat_counters sc\n  JOIN server_emojis se ON se.server_id = sc.server_id AND se.emoji_name = sc.metric_key\n  WHERE sc.metric = 'emoji_used' \n    AND se.emotion_key IS NOT NULL \n    AND $__timeFilter(sc.bucket)\n  UNION ALL\n  SELECT ss.emotion_key AS emotion_key, sc.count AS cnt\n  FROM stat_counters sc\n  JOIN server_stickers ss ON ss.server_id = sc.server_id AND ss.sticker_name = sc.metric_key\n  WHERE sc.metric = 'sticker_used' \n    AND ss.emotion_key IS NOT NULL \n    AND $__timeFilter(sc.bucket)\n  UNION ALL\n  SELECT LOWER(sc.metric_key) AS emotion_key, sc.count AS cnt\n  FROM stat_counters sc\n  WHERE sc.metric = 'sprite_emotion' \n    AND $__timeFilter(sc.bucket)\n) sub\nWHERE emotion_key != 'unset'\nGROUP BY emotion_key\nORDER BY \"metric\" DESC\nLIMIT 50;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Emotion Cloud",
      "type": "magnesium-wordcloud-panel"
    },
