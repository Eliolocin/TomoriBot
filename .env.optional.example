# Optional configuration reference
# Copy any values you want from here into your real .env file.

# Runtime Configuration (Default is development)
RUN_ENV=development

# Production container hardening (Optional)
# Azure Compose supplies these values explicitly. Self-hosted runtimes normally keep schema
# management enabled so startup can initialize/migrate the database.
TOMORIBOT_MEMORY_LIMIT_MB=1536
# Total memory+swap for the container, so the swap allowance is this minus the limit above. Leaving
# it unset lets Docker derive 2x the memory limit, which on a swap-backed host can saturate and then
# block the cgroup from swapping to any tier at all. Size it above the host's compressed swap device
# so overflow reaches disk.
TOMORIBOT_MEMORY_SWAP_LIMIT_MB=3072
TOMORIBOT_PIDS_LIMIT=256
SEARXNG_MEMORY_LIMIT_MB=512
SEARXNG_PIDS_LIMIT=128
FETCH_URL_ALLOW_PRIVATE_NETWORK=false
DATABASE_SCHEMA_MANAGEMENT_ENABLED=true

# PostgreSQL connection-pool hygiene (Production Optional, values in SECONDS)
# Applies only to production connections. Managed public endpoints (e.g. Azure
# Database for PostgreSQL Flexible Server) reap idle TCP connections at their
# gateway after ~4 minutes without a RST; a reaped pooled connection then black-
# holes the next query until an app timeout fires (~3 min), which stalled chat
# turns after the move off the private endpoint. These recycle idle connections
# before the gateway can reap them and fail fast on a dead path. Defaults are safe
# for all managed providers; only tune during an incident.
# Close idle pooled connections after N seconds (default: 30, min: 5).
POSTGRES_IDLE_TIMEOUT_SECONDS=30
# Hard cap on total connection age (default: 600, min: 30).
POSTGRES_MAX_LIFETIME_SECONDS=600
# Fail a connection attempt after N seconds instead of hanging (default: 10, min: 1).
POSTGRES_CONNECTION_TIMEOUT_SECONDS=10

# Bun's pool fires the two timeouts above without draining, rejecting queries that were
# in flight on the retired connection (oven-sh/bun#30646). Repositories re-issue those
# through withTransientDbRetry. Total attempts including the first, so 1 disables the
# retry (default: 2, min: 1).
POSTGRES_TRANSIENT_RETRY_ATTEMPTS=2
# Wait N ms before re-issuing so the pool can finish replacing the socket (default: 100, min: 0).
POSTGRES_TRANSIENT_RETRY_DELAY_MS=100

# pgvector detection runs at startup. If it never reached the server, RAG stays gated and
# ragAvailabilityMonitor re-probes on this interval until it succeeds, then stops. A startup
# probe that completed (pgvector present or genuinely absent) starts no timer at all.
# (default: 300000 = 5 minutes, min: 1000).
RAG_AVAILABILITY_REPROBE_INTERVAL_MS=300000

# Bot Configuration (Optional)
DEFAULT_BOTNAME=Tomori
DEFAULT_BOTNAME_JP=ともり
BASE_TRIGGER_WORDS=tomori,tomo,トモリ,ともり
# Grace period before greeting a new guild member (default: 60000 ms; 0 disables the delay).
WELCOME_DELAY_MS=60000
# Local tokenizer asset root for model-aware logit-bias resolution (default: ./tokenizers)
# Download tokenizer assets: bun run setup:tokenizers
# For gated models, set HF_TOKEN: HF_TOKEN=hf_xxx bun run setup:tokenizers
TOKENIZER_ASSET_DIR=./tokenizers

# Maintenance / validation scripts (Optional)
# Override where backup scripts write bundles (default: ./backups).
TOMORI_BACKUP_DIR=./backups
# Override which environment file backup/restore scripts copy or restore (default: ./.env).
TOMORI_ENV_FILE=./.env
# On development startup, TomoriBot creates an automatic data backup before DB
# initialization when the latest data backup is from another bot version or is
# older than this interval. Automatic backups are pruned separately from manual
# `bun run backup` bundles.
TOMORI_AUTO_BACKUP_ENABLED=true
TOMORI_AUTO_BACKUP_INTERVAL_HOURS=24
TOMORI_AUTO_BACKUP_MAX=5
# Maintenance database used by bun run db:lifecycle when creating a disposable validation DB.
# The configured PostgreSQL user needs permission to CREATE/DROP databases.
POSTGRES_MAINTENANCE_DB=postgres
# Safety override for bun run vl db on non-local disposable DB hosts. Leave false for normal use.
TOMORI_VL_ALLOW_NONLOCAL_DB=false
# How long bun run vl waits for the advisory registry before giving up on bun audit.
# The audit is the only network-dependent check, so an unreachable registry would
# otherwise stall the whole gate. On timeout it reports a warning, never a pass.
TOMORI_VL_AUDIT_TIMEOUT_MS=60000
# Dangerous non-interactive maintenance confirmations.
# Leave blank for normal use. These exact values are only for disposable CI/validation databases.
TOMORI_NUKE_CONFIRM=
TOMORI_RESTORE_CONFIRM=
TOMORI_RESTORE_FORCE_NONEMPTY=

# Speech sample upload limit for /config speech voice-add (default: 10)
SPEECH_SAMPLE_MAX_MB=10

# S3-Compatible Object Storage
# Optional endpoint override for Cloudflare R2 or other S3-compatible providers.
# For R2, set S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com and use region "auto".
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Voice Sample Storage
# Production: stable local-clone reference samples are stored in S3/CloudFront.
# Bucket + region fall back to avatar storage values when left blank.
VOICE_SAMPLE_S3_BUCKET=
VOICE_SAMPLE_S3_REGION=
VOICE_SAMPLE_S3_PREFIX=voice-samples
VOICE_SAMPLE_PUBLIC_BASE_URL=

# Avatar Storage
# Production: stable persona avatars are stored in S3/CloudFront.
# Non-production: alter persona avatars are stored locally under data/avatars.
# If AVATAR_PUBLIC_BASE_URL is set in non-production, it should publicly serve data/avatars/
# and TomoriBot will build avatar URLs from local stored paths. If unset, TomoriBot falls
# back to mutating the shared Discord webhook avatar at send time.
AVATAR_S3_BUCKET=
# Optional override for S3 region (defaults to AWS_REGION or us-east-1)
AVATAR_S3_REGION=
# Optional prefix for avatar objects inside the bucket
AVATAR_S3_PREFIX=avatars
# Optional public base URL.
# Production: CloudFront/custom domain override; defaults to S3 public URL when unset.
# Non-production: public root that serves files from data/avatars/ when URL mode is desired.
AVATAR_PUBLIC_BASE_URL=

# Persona Picker Workflow (Optional)
# How long in-place persona workflow buttons remain active (default: 120000 ms).
PERSONA_WORKFLOW_COMPONENT_TIMEOUT_MS=120000

# Character Reference Storage (Production Optional)
# Used by /novelai charreference for stable persona/user reference images.
# Bucket + region fall back to the avatar storage values when left blank.
CHARREF_S3_BUCKET=
CHARREF_S3_REGION=
CHARREF_S3_PREFIX=charreferences
CHARREF_PUBLIC_BASE_URL=

# GitHub Release Fetching (Optional - used by /help updates)
# Repository in owner/repo format for fetching latest release notes via the public GitHub API
GITHUB_REPO=Bredrumb/TomoriBot
# Timeout in milliseconds for the GitHub API request (default: 10000)
GITHUB_API_TIMEOUT_MS=10000

# TTS Synthesize Timeout (Optional)
# Timeout in milliseconds for /synthesize requests to local TTS clone and VoiceDesign servers (default: 240000).
# Increase this if large models (e.g. Qwen3-TTS 1.7B on CPU) time out before finishing generation.
TTS_SYNTHESIZE_TIMEOUT_MS=240000
# Backward-compatible legacy name. Used only when TTS_SYNTHESIZE_TIMEOUT_MS is unset.
# TTS_CLONE_TIMEOUT_MS=240000

# NovelAI Timeouts (Optional)
# Overall request timeout in milliseconds (default: 60000)
NOVELAI_REQUEST_TIMEOUT_MS=60000
# Per-read inactivity timeout for streaming - aborts if NAI stops sending data (default: 30000)
NOVELAI_STREAM_READ_TIMEOUT_MS=30000

# NVIDIA NIM Image Generation (Optional)
# Sampling steps for NVIDIA-hosted FLUX image generation, 1-50 (default: 30).
# Raise for quality, lower for latency.
NVIDIA_IMAGE_STEPS=30
# Classifier-free guidance scale, 0-10 (default: 3.5). FLUX.1-dev is tuned for low guidance.
NVIDIA_IMAGE_CFG_SCALE=3.5

# NovelAI Image Generation (Optional)
# Default imggen parameters used when /novelai imggen params has no server override.
NAI_IMAGE_STEPS=23
NAI_IMAGE_SCALE=5
NAI_IMAGE_SAMPLER=k_euler_ancestral
NAI_IMAGE_NOISE_SCHEDULE=karras
NAI_CFG_RESCALE=0.0
# Enable suggest-tags prompt resolution for /generate_image_nai (default: false).
# Keep this disabled while NovelAI's suggest-tags API is unstable.
NAI_IMAGE_ENABLE_TAG_RESOLUTION=false
# Image tag modal limits used by /personal image-tags, /persona image-tags, and /config image-tags.
IMAGE_TAG_MAX_TAGS=100
IMAGE_TAG_MAX_TAG_LENGTH=200
# When true, DMs the invoking user the segmentation mask during inpainting for debugging (default: false)
NAI_INPAINT_DEBUG=false
# Inpainting denoising strength for the masked region, 0.0-1.0 (default: 1.0)
# 1.0 = full redraw from prompt; lower values preserve structure but bleed original colors
NAI_INPAINT_STRENGTH=1.0
# When true, generate_image_nai will normalize saved character refs to NovelAI's supported canvases
# and send them through director_reference_images for single-character generations.
# Multi-character generations intentionally skip saved refs to avoid whole-image reference bleed.
NAI_ENABLE_CHAR_REFERENCES=true
# Director-reference strength applied to each resolved character reference image in generate_image_nai (default: 0.6)
NAI_CHAR_REF_STRENGTH=0.6
# Director-reference information extraction value for saved character refs (default: 1.0)
NAI_CHAR_REF_INFO_EXTRACTED=1.0
# Director-reference secondary strength value for saved character refs (default: 0.0)
NAI_CHAR_REF_SECONDARY_STRENGTH=0.0
# Director-reference description preset for saved character refs (default: character&style)
NAI_CHAR_REF_DESCRIPTION=character&style
# Gemini model used for image segmentation during inpainting (default: gemini-2.5-flash)
NAI_SEGMENTATION_MODEL=gemini-2.5-flash
# Timeout in milliseconds for the Gemini segmentation API call (default: 90000)
NAI_SEGMENTATION_TIMEOUT_MS=90000
# Padding added to each side of the bounding box as a fraction (0.0-1.0) of the box dimension (default: 0.15)
# Higher values capture more surrounding area - useful for regions that extend beyond the detected box (e.g. wispy hair)
NAI_INPAINT_PADDING=0.15

# Memory Limits (Optional)
# These runtime limits are enforced during creation. Non-numeric, zero, and negative
# values fall back to defaults; high positive values are accepted and are the admin's responsibility.
# Length values are characters. Count values are item counts.
# Preset export/import uses separate schema safety limits below.
# Counts are per persona lineage, so a server running several personas holds this
# many memories per persona rather than in total.
MAX_PERSONAL_MEMORIES=100
MAX_SERVER_MEMORIES=100
MAX_MEMORY_LENGTH=1000
MAX_PERSONAS_PER_SERVER=20
MAX_SAMPLE_DIALOGUE_LENGTH=2000
MAX_ATTRIBUTE_LENGTH=2000
MAX_TRIGGER_WORDS=10
MAX_SAMPLE_DIALOGUES=15
MAX_ATTRIBUTES=10

# Preset Import/Export Schema Limits (Optional)
# These limits validate external Tomori/SillyTavern persona files and generated presets.
# High positive values are accepted and are the admin's responsibility, but raising them
# can reduce cross-instance preset portability and allow larger untrusted import payloads.
# String length is characters; other values are item counts.
PRESET_MAX_STRING_LENGTH=5000
PRESET_MAX_ATTRIBUTES=200
PRESET_MAX_SAMPLE_DIALOGUES=100
PRESET_MAX_TRIGGER_WORDS=100
PRESET_MAX_IMAGE_TAGS=200

# Non-Env Hard Limits (Reference)
# Most remaining non-env caps mirror external protocol constraints, database schema
# validation, or provider API ranges. If a limit is not listed in this file, treat it
# as a protocol/schema safety bound that needs a code/schema review before changing.

# Conditioning memory limits (Optional)
# Maximum length of the optional reason stored by /reward and /punish (default: 250)
CONDITIONING_REASON_MAX_LENGTH=250
# Maximum grouped reward entries and punishment entries injected into prompt context per type (default: 10)
CONDITIONING_CONTEXT_MAX_GROUPS_PER_TYPE=10

# Document/RAG Limits (Optional)
# High positive values are accepted. Keep DOCUMENT_CHUNK_OVERLAP lower than DOCUMENT_CHUNK_SIZE.
# Size values are MB, text/chunk values are characters, and document/chunk limits are counts.
MAX_DOCUMENT_SIZE_MB=4
MAX_DOCUMENT_TEXT_LENGTH=120000
# Keep DOCUMENT_CHUNK_SIZE below 4000: Discord's modal Paragraph input caps at 4000 characters,
# so chunks larger than that can't be edited via /memory document view.
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
MAX_DOCUMENT_CHUNKS=150
# MAX_DOCUMENTS_PER_SERVER: Maximum document count per selected document scope.
MAX_DOCUMENTS_PER_SERVER=20
# MAX_DOCUMENT_CHUNKS_PER_SERVER: Maximum total chunk count per selected document scope.
MAX_DOCUMENT_CHUNKS_PER_SERVER=1000
# DOCUMENT_MAX_RESULTS: Maximum number of chunks retrieved per RAG query turn (total across all documents, ranked by similarity).
DOCUMENT_MAX_RESULTS=6
# DOCUMENT_MIN_SIMILARITY: Minimum cosine similarity (0.0–1.0) for a chunk to be included in RAG results.
# Similarity is derived from cosine distance: similarity = 1 - distance. A value of 1.0 is a perfect match,
# 0.0 is completely unrelated. Lower values return more (looser) matches; higher values return fewer (stricter) matches.
DOCUMENT_MIN_SIMILARITY=0.5
# RAG is auto-enabled when pgvector extension is detected in PostgreSQL (see README.md)

# Inline Document Reading (read_document tool) - limits for chat-time document extraction
# Size is MB. Text length is characters. History/image limits are message counts.
CHAT_DOCUMENT_MAX_SIZE_MB=8
CHAT_DOCUMENT_MAX_TEXT_LENGTH=200000
# Default fetch window is 80 messages (configurable per server via /config maxmsgfetch)
HISTORY_EXTRACTION_WINDOW_SIZE=40
BOT_GENERATE_IMAGE_HISTORY_LIMIT=24
BOT_GENERATE_IMAGE_AGENT_MAX_ITERATIONS=5

# /bot generate scene - maximum number of rounds (full passes through the speaking
# order) the modal accepts. TomoriBot is BYOK, so each generated turn bills the
# invoking user's own provider; a higher cap is safe. Default: 10, minimum: 1.
BOT_GENERATE_SCENE_MAX_CYCLES=10
# Maximum text held while checking whether a Custom endpoint response is exactly
# an opt-in verbatim tool call such as `read_file("media_1")`.
VERBATIM_TOOL_CALL_MAX_BUFFER_CHARS=8192
# Enabled by default. Set false to omit TomoriBot app attribution headers from
# OpenRouter requests and opt out of OpenRouter app rankings/analytics.
OPENROUTER_APP_ATTRIBUTION_ENABLED=true

# OpenRouter Model Catalogs (Optional)
# TomoriBot caches OpenRouter's four model catalogs (text, embedding, image, video) in
# memory. A lookup that misses refreshes the matching catalog, so a model published after
# the bot started can be registered with /openrouter model add without a restart.
# Minimum gap in milliseconds between refresh attempts for one catalog (default: 60000).
# This bounds how often an unrecognized model codename can reach OpenRouter, process-wide.
# Set 0 to refresh on every miss.
OPENROUTER_CATALOG_REFRESH_MIN_INTERVAL_MS=60000
# Age in milliseconds after which a catalog is refreshed in the background (default: 21600000, 6h).
# Governs how stale cached pricing, context limits, and supported parameters can get, since
# those are read synchronously per turn and never trigger a refresh of their own.
OPENROUTER_CATALOG_TTL_MS=21600000

# API Key Rotation Cooldowns (Optional)
# Cooldown in milliseconds before a key that hit a rate limit (429) is retried (default: 60000)
KEY_ROTATION_RATE_LIMIT_COOLDOWN_MS=60000
# Cooldown in milliseconds before a key that hit another API error (401, 403, etc.) is retried (default: 300000)
KEY_ROTATION_ERROR_COOLDOWN_MS=300000

# Rate Limiting (Optional)
# Maximum active messages (processing + queued) per user across all servers (production default: 3)
MAX_USER_ACTIVE_MESSAGES=3
# Maximum active messages (processing + queued) per server across all channels (production default: 10)
MAX_SERVER_ACTIVE_MESSAGES=10
# Maximum document upload operations per user per 24 hours
MAX_DOCUMENT_OPERATIONS_PER_DAY=20

# Command Cooldowns (Optional)
# All cooldown values are in milliseconds. COOLDOWN_TEACH/FORGET are legacy fallbacks.
DEFAULT_COMMAND_COOLDOWN=1600
COOLDOWN_CONFIG=3000
COOLDOWN_TEACH=3000
COOLDOWN_FORGET=3000
COOLDOWN_PERSONA=10000
COOLDOWN_MEMORY=3000
COOLDOWN_SERVER=3000
COOLDOWN_PERSONAL=3000
COOLDOWN_CONDITIONING=3000

# Persona sprite limits/cache (Optional)
# Sprites are custom per-persona webhook avatars selected by labels like "Tomori (mad):".
PERSONA_SPRITE_MAX_PER_PERSONA=50
PERSONA_SPRITE_MAX_INSTRUCTIONS_LENGTH=300
PERSONA_SPRITE_PROMPT_MAX_COUNT=20
PERSONA_SPRITE_CACHE_TTL_MINUTES=10
# Sprite messages display a clean persona name; the message -> sprite-label
# mapping is persisted so context rebuilding can recover "Name (sprite):".
# Retention bounds the mapping table; cache TTL bounds the in-memory lookup map.
PERSONA_SPRITE_MESSAGE_RETENTION_DAYS=30
PERSONA_SPRITE_MESSAGE_CACHE_TTL_MINUTES=120
# Discord groups consecutive webhook messages sharing a username and ignores the
# per-message avatar, so adjacent sprites alternate between the clean persona name
# and the decorated "Persona (sprite)" name. That alternation is tracked per channel
# across turns; this bounds how long it is remembered. Set it near Discord's own
# grouping window — once messages are further apart they never group anyway.
SPRITE_GROUP_CONTINUITY_TTL_MINUTES=10

# Persona user blocking (Optional)
# Maximum block_user duration in hours; cache TTL bounds active block lookups.
BLOCK_USER_MAX_DURATION_HOURS=168
PERSONA_USER_BLOCK_CACHE_TTL_SECONDS=60

# Participant extension execution (Optional)
# Per-source and per-profile-enricher timeout. Optional contributions are skipped on
# timeout; critical first-party contributions fail the context build structurally.
PARTICIPANT_SOURCE_TIMEOUT_MS=1500
PARTICIPANT_ENRICHER_TIMEOUT_MS=1500

# Memory & Media Protection (Optional)
# Number of most recent messages that can contain full media (images, videos, GIFs)
MEDIA_CONTEXT_WINDOW=10
# Maximum size per individual media file in MB for context, analysis, generation
# references, and bounded provider media downloads (default: 10 MB)
MAX_MEDIA_SIZE_MB=10
# Maximum size in MB for persona avatar and sprite images (default: 10 MB)
MAX_AVATAR_SIZE_MB=10
# Maximum number of recent messages with non-emoji, non-sticker images that can
# render direct image parts inside the media window (default: 3). Additional
# image-bearing messages stay text-visible but their real image payloads are skipped.
MEDIA_IMAGE_MESSAGE_LIMIT=3
# Maximum size per individual GIF file in MB (for process_gif tool in development)
MAX_GIF_SIZE_MB=50
# Maximum number of keyframes extracted from a GIF for LLM context (default: 10)
GIF_MAX_KEYFRAMES=10
# JPEG quality (1–100) used when compressing extracted GIF keyframes (default: 80)
# Higher = better quality but larger payload sent to the LLM provider.
GIF_JPEG_QUALITY=80
# Timeout in milliseconds for GIF processing before aborting (default: 30000)
# Increase if large GIFs time out on slow hardware.
GIF_PROCESSING_TIMEOUT_MS=30000
# Timeout in milliseconds for resolving a Tenor view URL to its direct GIF CDN URL
# (default: 5000). Guards against undici's 5-minute default headersTimeout when Tenor
# stalls on malformed or unknown GIF IDs. Failed resolves are non-fatal — the original
# URL is preserved as descriptive text context for the LLM.
TENOR_FETCH_TIMEOUT_MS=5000
# Image optimization for LLM context - oversized images are downscaled before
# sending to providers to prevent stream timeouts (especially on slower models).
# Raw buffer byte-size threshold that triggers dimension inspection (default: 2 MB)
IMAGE_CONTEXT_MAX_BYTES=2097152
# Maximum pixel dimension on the longest side before downscaling (default: 2048 px)
IMAGE_CONTEXT_MAX_DIMENSION=2048
# JPEG quality used when an image is downscaled (default: 85)
IMAGE_CONTEXT_JPEG_QUALITY=85
# Timeout in milliseconds for fetching images for LLM context (default: 20000).
# Increase if images are timing out on slow networks or high-latency Discord CDN proxies.
IMAGE_FETCH_TIMEOUT_MS=20000
# Maximum forward hops chased when a forwarded message is itself a forward (default: 3).
# Discord flattens nested forwards to an empty snapshot, so each extra level costs one
# message fetch to recover the original text and attachments. Set to 0 to disable the
# walk entirely — nested forwards then report their contents as unavailable.
FORWARD_CHAIN_MAX_DEPTH=3
# Maximum total time in milliseconds for analyze_image extraction and vision inference
# (default: 60000). Failed or stalled vision requests return control to the chat model
# after this deadline instead of waiting for the outer provider timeout.
VISION_ANALYSIS_TIMEOUT_MS=60000
# Maximum direct video upload size in MB to inline into Gemini/Vertex context.
VIDEO_CONTEXT_MAX_INLINE_MB=20
# Maximum provider-returned video download size in MB before re-upload to Discord.
PROVIDER_VIDEO_DOWNLOAD_MAX_MB=25
# Container memory limit in MB (set to match your deployment environment)
CONTAINER_MEMORY_LIMIT_MB=1024
# Memory warning threshold as percentage (0.75 = 75%)
MEMORY_WARNING_THRESHOLD=0.75
# Memory critical threshold as percentage (0.85 = 85%)
MEMORY_CRITICAL_THRESHOLD=0.85
# Emergency cooldown duration after critical memory pressure is detected.
# During cooldown, media processing stays disabled. Also rate-limits emergency cache clearing.
EMERGENCY_COOLDOWN_MS=60000
# Clear recoverable in-memory caches when emergency memory mode starts.
EMERGENCY_CACHE_CLEAR_ENABLED=true
# Keep short-term memory by default; set true only if emergency cache clearing is not enough.
EMERGENCY_CACHE_CLEAR_INCLUDE_STM=false
# Also clear volatile Discord.js message/user/presence/voice-state caches during emergency cleanup.
EMERGENCY_CACHE_CLEAR_DISCORD_VOLATILE=true
# Image processing limits. libvips memory is native, so it counts against the container limit
# without appearing in any cache the emergency clear can reach. Each concurrent pipeline holds
# fully decoded bitmaps, so concurrency is the main driver of peak usage; raise it only if you
# have headroom above CONTAINER_MEMORY_LIMIT_MB. Defaults suit a 512MB, 2-vCPU container.
SHARP_CONCURRENCY=1
# libvips operation cache size in MB (its own default is 50).
SHARP_CACHE_MEMORY_MB=16
# Maximum operations retained in the libvips cache.
SHARP_CACHE_ITEMS=50
# Open files retained by the libvips cache. 0 keeps no descriptors between operations.
SHARP_CACHE_FILES=0
# Maximum fetch response size in MB (protects against downloading large webpages)
MAX_FETCH_SIZE_MB=5
# Maximum characters returned by one fetch_url call before continuation is required.
FETCH_URL_MAX_CONTENT_LENGTH=50000
# URL fetch engine order. Unknown names are ignored, duplicates are collapsed,
# and safe_http is always appended as the final fallback.
FETCH_URL_ENGINE_ORDER=safe_http
# Per-engine HTTP request budget for Crawl4AI and future URL-fetch sidecars.
FETCH_URL_TIMEOUT_MS=15000
# How long URL-fetch sidecar health probes are cached before re-checking.
FETCH_URL_HEALTHCHECK_CACHE_SEC=60
# Production-only opt-in (RUN_ENV=production). Outside production the guard
# auto-relaxes, so local development can fetch localhost/private/internal
# networks (and use Crawl4AI) with no setup. Set true only if a production
# deployment must let users make fetch_url reach private/internal networks.
FETCH_URL_ALLOW_PRIVATE_NETWORK=false
# Crawl4AI browser-rendered markdown sidecar. Leave blank to disable.
# With docker compose, enable the sidecar with:
#   docker compose --profile fetch-crawl4ai up
# and set this to http://crawl4ai:11235/ for the app container.
CRAWL4AI_BASE_URL=
# Optional bearer token. Must match CRAWL4AI_API_TOKEN on the Crawl4AI container when enabled.
CRAWL4AI_TOKEN=
# Browser-level cookie injection for authenticated fetches (e.g. Twitter/X).
# JSON array of cookie objects: [{"name":"auth_token","value":"...","domain":".x.com"}]
# When set, fetch_url switches from /md to /crawl so browser_config.cookies can be applied.
# For X/Twitter you need both auth_token and ct0 cookies from your logged-in browser session.
CRAWL4AI_COOKIES_JSON=
# Crawl4AI /md filter mode. `fit` is the default LLM-friendly content filter.
FETCH_URL_FILTER_MODE=fit
# Brave image-search result URL validation/download limits.
BRAVE_IMAGE_DISCORD_LIMIT_MB=8
BRAVE_IMAGE_COMPRESSION_TARGET_MB=7
BRAVE_IMAGE_DOWNLOAD_MAX_MB=25
# Minimum image size in bytes for both Brave and SearXNG image search (default 5120 = 5 KB).
# Images smaller than this are rejected — they are typically placeholder/error images that
# Discord renders as raw file attachments rather than inline media.
IMAGE_MIN_SIZE_BYTES=5120
# Max images SearXNG will validate as candidates (default 10, max 20).
# Larger than SEARXNG_IMAGE_COUNT to absorb expected hotlink-protection failures
# from aggregated engines without overwhelming the 3s validation window.
SEARXNG_IMAGE_POOL=10
# Max valid images SearXNG image search will send to Discord (default 3, max 10).
SEARXNG_IMAGE_COUNT=3

# SearXNG self-hosted metasearch sidecar (Phase 2 — optional).
# If set, the web-search engine chain becomes:
#   Brave (when API key present) → SearXNG → DuckDuckGo → Felo.
# Leave unset to disable; the chain falls back to Brave → DDG → Felo.
SEARXNG_BASE_URL=
# Secret key consumed by the SearXNG container itself (NOT by TomoriBot).
# Must match the value substituted into servers/searxng/settings.yml.
SEARXNG_SECRET=
# Per-engine HTTP request budget for the web-search chain (Brave/SearXNG/DDG).
WEB_SEARCH_TIMEOUT_MS=5000
# How long the "SearXNG is reachable" probe is cached before re-checking.
WEB_SEARCH_HEALTHCHECK_CACHE_SEC=60
# Memory monitor polling interval in milliseconds (how often to check memory status)
MEMORY_MONITOR_INTERVAL_MS=30000
# Cache metrics logger interval in milliseconds (periodic size snapshots for CloudWatch)
# Emits one structured log.metric("cache_sizes", {...}) line per interval covering every
# in-memory cache (STM, webhook, tomoriState, user, whitelist, discord.js client caches)
# plus process RSS. Default: 300000 (5 minutes). Set lower for faster diagnosis.
CACHE_METRICS_INTERVAL_MS=300000
# Directory for on-demand heap snapshots. Unset leaves the SIGUSR2 handler unregistered, so
# no snapshot can be taken; the Azure compose file sets it because arming the handler is
# inert and a snapshot would otherwise need a deploy, which discards the heap it wanted.
# When set, sending SIGUSR2 to the bot process
# writes a Chrome DevTools .heapsnapshot there, which is the only way to attribute
# external/arrayBuffers growth that the cache_sizes counters do not decompose.
# Point it at a writable mount: the container root filesystem is read-only in production.
# Cost: the snapshot serializes to roughly half the live heap as one string, so taking one
# on a memory-constrained host is itself a pressure event. Prefer moderate uptime over a
# deep one, and restart the container afterwards.
# HEAP_SNAPSHOT_DIR=/var/log/tomoribot
# Scheduled work reconcile interval in milliseconds (backstop DB resync for reminders/random triggers)
SCHEDULED_WORK_RECONCILE_INTERVAL_MS=60000
# Delay before retrying a reminder/task delivery that was not acknowledged, such as when /bot kill clears it
REMINDER_DELIVERY_RETRY_DELAY_MS=60000
# Unacknowledged delivery retries allowed before a plain fallback is shown; recurring cadence is retained
REMINDER_DELIVERY_MAX_RETRIES=5

# Reaction Context Enrichment (Optional)
# Include per-message reaction metadata in LLM context (emoji, counts, and reactor names when budget allows)
REACTION_CONTEXT_ENABLED=true
# Max reaction user-fetch API calls per generation turn (counts-only fallback after this budget is exhausted)
REACTION_CONTEXT_MAX_API_CALLS_PER_TURN=20
# Max distinct reaction types included per message (sorted by highest count first)
REACTION_CONTEXT_MAX_REACTIONS_PER_MESSAGE=4
# Max reactor identities fetched per reaction type
REACTION_CONTEXT_MAX_USERS_PER_REACTION=5

# Cache TTL Configuration (Optional)
# Time-to-live for in-memory caches in minutes. Lower values = fresher data but more DB queries.
# TomoriState cache: server config, personality, memories (default: 10 minutes)
TOMORI_STATE_CACHE_TTL_MINUTES=10
# Grace period after bot startup where "not set up" results are treated as
# "currently updating" to avoid misleading users during ECS deployments (default: 3 minutes)
STARTUP_GRACE_PERIOD_MINUTES=3
# User cache: user preferences, privacy level, personal memories (default: 30 minutes)
USER_CACHE_TTL_MINUTES=30
# Emoji/Sticker cache: server emoji and sticker lists (default: 10 minutes)
EMOJI_STICKER_CACHE_TTL_MINUTES=10
# Channel Whitelist cache: whitelist status and per-channel cooldown overrides (default: 5 minutes)
CHANNEL_WHITELIST_CACHE_TTL_MINUTES=5
# Personal Spotlight cache: per-user/per-channel spotlight persona sets and auto-trigger persona (default: 5 minutes)
PERSONAL_SPOTLIGHT_CACHE_TTL_MINUTES=5
# Hard entry cap for the spotlight cache. Its key is a server/user/channel triple and misses
# are cached, so it grows fastest of any cache; expired entries are dropped first, then
# oldest-inserted (default: 2000)
PERSONAL_SPOTLIGHT_CACHE_MAX_ENTRIES=2000

# Short-Term Memory Configuration (Optional)
# Short-term memory stores recent conversations for cross-channel awareness
# Crude conversation TTL: How long to keep raw conversation history in hours (default: 12)
SHORT_TERM_MEMORY_TTL_HOURS=12
# Summary TTL: How long to keep AI-generated summaries in hours (default: 24, longer than crude)
SHORT_TERM_MEMORY_SUMMARY_TTL_HOURS=24
# Maximum character length for AI-generated summaries (default: 1500)
SHORT_TERM_MEMORY_MAX_SUMMARY_LENGTH=1500
# Default crude-message render depth when a server has no crude_message_count set —
# caps how many recent crude messages render into crude context (default: 6)
SHORT_TERM_MEMORY_DEFAULT_CRUDE_MESSAGE_COUNT=6
# Maximum number of messages stored per channel in crude conversation history (default: 10).
# Also caps the /server stm parameters crude-messages option.
SHORT_TERM_MEMORY_MAX_MESSAGES_PER_CHANNEL=10
# Maximum number of other-channel memories to show in context (excludes current channel, default: 3)
SHORT_TERM_MEMORY_MAX_OTHER_CHANNELS=3

# Google Gemini Configuration (Optional)
# Hard cap on maxOutputTokens sent to Gemini (default: 8192). Also reserved by the
# context truncator so history isn't over-dropped. A server's `/model parameters`
# output-tokens override (llm_max_output_tokens) takes precedence over this.
GOOGLE_MAX_OUTPUT_TOKENS=8192
# Enable frequencyPenalty/presencePenalty for Google requests (default: false).
# Leave disabled unless you have confirmed your specific Gemini model accepts them.
GOOGLE_ENABLE_PENALTY_PARAMS=false

# OpenRouter Configuration (Optional)
# Hard cap on max_tokens sent to OpenRouter, regardless of what the model reports.
# Prevents HTTP 402 errors on accounts with low daily credit limits (default: 8192).
# Also reserved by the context truncator so history isn't over-dropped. A server's
# `/model parameters` output-tokens override (llm_max_output_tokens) takes precedence.
OPENROUTER_MAX_OUTPUT_TOKENS=8192
# Safety factor for dynamic context-window output capping (default: 0.9)
# Lower values are more conservative; higher values reserve more output tokens.
OPENROUTER_OUTPUT_SAFETY_FACTOR=0.9
# Best-effort minimum output tokens for OpenRouter requests (default: 256)
# Applied only when estimated remaining context can still fit this floor.
OPENROUTER_MIN_OUTPUT_TOKENS=256
# When true, Bun fetch requests to OpenRouter use verbose network logging for debugging (default: true)
OPENROUTER_VERBOSE_FETCH=true
# On empty-response retries caused by finishReason=\"length\", drop this many oldest
# dialogue history exchange pairs per retry attempt (default: 2).
OPENROUTER_LENGTH_EMPTY_RETRY_DROP_PAIRS=2

# Custom OpenAI-Compatible Provider Configuration (Optional)
# Batch size for /server initialize expressions when using the custom provider (default: 20)
CUSTOM_EXPRESSION_BATCH_SIZE=20

# /server initialize expressions now drains the whole emoji/sticker backlog on its
# own (one provider-sized batch per iteration) instead of asking you to re-run it.
# Loop-safety guard: if a batch makes no progress (same number of items left as the
# previous iteration), it counts as a retry of that "stuck" chunk. After this many
# consecutive no-progress attempts the loop aborts so a misbehaving model can never
# loop forever (default: 3).
EXPRESSION_INIT_MAX_CHUNK_RETRIES=3
# Pause in milliseconds between expression batches to stay within provider rate
# limits. Set to 0 to disable the delay (default: 1000).
EXPRESSION_INIT_BATCH_DELAY_MS=1000
# Target pixel area for ComfyUI image dimension resolution (default: 1048576 = 1024×1024)
# Width and height are solved so their product equals this area while matching the requested aspect ratio.
COMFYUI_IMAGE_TARGET_AREA=1048576
# Maximum number of reference images sent to image providers (default: 3)
IMAGE_REFERENCE_MAX_COUNT=3
# Total base64 payload byte budget for image reference inputs (default: 6291456 = 6 MiB)
IMAGE_REFERENCE_MAX_TOTAL_BYTES=6291456
# Single-reference retry byte target after a 413/payload-too-large response (default: 950000)
IMAGE_REFERENCE_TINY_MAX_BYTES=950000
# Per-reference byte budget before downscaling (default: 2097152 = 2 MiB)
IMAGE_REFERENCE_MAX_SINGLE_BYTES=2097152
# ComfyUI image/video runtime knobs. Most workflow details live in the workflow JSON.
# When true, unload ComfyUI models after a successful image or video generation (default: false).
COMFYUI_UNLOAD_MODELS_AFTER_SUCCESS=false
COMFYUI_REFERENCE_DENOISE=0.75
COMFYUI_IMG2IMG_DENOISE=0.75
COMFYUI_LANPAINT_STEPS=16
COMFYUI_LANPAINT_NUM_STEPS=3
COMFYUI_LANPAINT_SAMPLER=er_sde
COMFYUI_OUTPAINT_STEPS=20
COMFYUI_OUTPAINT_THINKING_STEPS=2
COMFYUI_OUTPAINT_CFG=3
COMFYUI_OUTPAINT_SAMPLER=euler
# Default frames-per-second injected into ComfyUI video workflows (via the TOMORI_VIDEO_FPS /
# TOMORI_FPS placeholders) when a /generate video request leaves the FPS field blank (default: 16)
COMFYUI_VIDEO_FPS=16
# /generate video modal input bounds. Duration is required; FPS is optional. Providers still
# normalize values to their own supported ranges, so these are UI-level guardrails only.
VIDEO_GEN_DEFAULT_DURATION_SECONDS=5
VIDEO_GEN_MAX_DURATION_SECONDS=20
VIDEO_GEN_MAX_FPS=60
# Port that ChatMock listens on - used to auto-detect Chatmock endpoints and inject the system
# prompt as an in-band user turn (ChatMock strips system-role messages before forwarding to
# Codex CLI). Override only if you run ChatMock on a non-default port. (default: 8000)
CHATMOCK_PORT=8000
# Gemma 4 running via KoboldCPP at low quant leaks its <|tool_call>...<tool_call|> vocabulary
# tokens into delta.content instead of using delta.tool_calls. Set to false to disable the
# in-stream scanner if another local model unexpectedly produces similar token strings. (default: true)
CUSTOM_GEMMA_TOOL_PARSER_ENABLED=true
# When KoboldCPP emits a tool call immediately after a Gemma 4 thinking block, the entire
# <|channel>thought...<channel|><|tool_call>...<tool_call|> blob arrives as raw delta.content.
# This parser strips the thinking block and routes it to the thought log before the tool call
# parser runs. Set to false if a non-Gemma model produces similar token strings. (default: true)
CUSTOM_GEMMA_THINKING_PARSER_ENABLED=true

# /tool estimate cost Configuration (Optional)
# Estimated output token bands shown in /tool estimate cost for current-context mode
HELP_COST_EST_OUTPUT_SHORT=80
HELP_COST_EST_OUTPUT_TYPICAL=220
HELP_COST_EST_OUTPUT_LONG=500
# Per-model prices are no longer env-configurable. They live on the `llms` catalog rows
# (inputPricePerMillion / outputPricePerMillion in src/db/seed/catalog/models.ts) and seed into the
# input_price_per_million / output_price_per_million columns on boot. OpenRouter is priced live from its
# API; a model with no catalog price reports "pricing unavailable" rather than billing a generic fallback.

# NovelAI GLM Configuration (Optional)
# Enable/disable internal reasoning (thinking) for GLM 4.6 (default: true)
# When enabled, the model can reason before responding (improves tool calling quality)
# When disabled, /nothink is appended to suppress reasoning (faster, but may degrade tool use)
NAI_GLM_THINKING_ENABLED=true
# Maximum consecutive tool failures before showing an error embed (NAI GLM only)
NAI_TOOL_FAILURE_RETRY_THRESHOLD=3
# Maximum tool-call round-trips per chat turn before showing the \"Thinking Loop\" error embed (default: 100, min: 1)
BOT_MAX_FUNCTION_CALL_ITERATIONS=100
# Maximum consecutive tool-execution failures before showing a \"Tool Error Loop\" embed and aborting the turn early.
# Provider-agnostic flail guard; fires well before BOT_MAX_FUNCTION_CALL_ITERATIONS when the model is stuck
# repeating the same failing tool call. Counter resets on any successful tool execution. (default: 5, min: 1)
BOT_MAX_CONSECUTIVE_TOOL_ERRORS=5
# Include \"{char}:\" prefix in GLM 4.6 assistant turns and append it as a generation prefill (default: true)
# When enabled (default): bot name is kept in sample dialogue + history turns (mirrors Google/OpenRouter format),
# and \"{botName}:\" is appended after <think></think> at generation time to steer persona voice.
# When disabled: bot name is stripped - <|assistant|> tag is the structural signal alone
# (legacy behaviour; may produce garbled name artifacts like \"Tomo\", \"Tomorleasing\").
NAI_GLM_CHAR_PREFIX_ENABLED=true
# Characters-per-token ratio used to estimate GLM 4.6 input token count from prompt length (default: 2.5)
# GLM 4.6 tokenizes at ~2.2-2.5 chars/token - much denser than the 4 chars/token assumed by the
# context truncator. This value drives the dynamic max_length cap in novelaiStreamAdapter.ts that
# prevents 400 \"too much context\" errors caused by formatting overhead (GLM role tags, tool guide, etc.)
# not measured during contextItem truncation. Lower = more conservative (more clamping, shorter replies).
NAI_GLM_CHARS_PER_TOKEN=2.5
# Hard context window ceiling (input + output tokens combined) for GLM 4.6 (default: 12288)
# Used together with NAI_GLM_CHARS_PER_TOKEN to compute the dynamic max_length safety cap.
# Should match the actual NovelAI API limit for GLM 4.6. Adjusting novelaiCapabilityCache.ts
# (contextLength: 8_192) separately compensates for estimation errors in the truncator.
NAI_GLM_CONTEXT_LIMIT=12288

# Kayra context limit - override or fallback for the subscription tier auto-detect.
# By default, TomoriBot calls GET /user/subscription and maps the tier number to a known limit:
#   Tier 1 (Tablet):  4096 tokens
#   Tier 2 (Scroll):  8192 tokens (fallback default)
#   Tier 3 (Opus):    8192 tokens
# If this env var is EXPLICITLY SET, it takes priority over the API lookup entirely
# (no subscription API call is made). Leave it unset to use the auto-detect.
# Uncomment and set only if auto-detect gives wrong results or you want to skip the API call:
#NAI_KAYRA_CONTEXT_LIMIT=8192
# Characters-per-token ratio for Kayra context estimation (default: 3.5)
# Kayra tokenizes at ~3.0-3.5 chars/token. Used to compute a corrected virtual contextLength
# so the truncator's 4 chars/token estimate doesn't overshoot the real tier limit.
# Lower = more conservative truncation; higher = less truncation.
NAI_KAYRA_CHARS_PER_TOKEN=3.5

# Emoji Repetition Penalty (Optional)
# NOTE: Only counts custom server emojis (:name:), NOT Unicode emojis
EMOJI_PENALTY_ENABLED=true
# Number of recent bot messages to analyze for custom emoji usage
EMOJI_PENALTY_LOOKBACK=3
# Maximum total custom emojis allowed across lookback window (exceeding this triggers penalty)
EMOJI_PENALTY_THRESHOLD=1

# Unique Emoji Enforcement (Optional)
EMOJI_UNIQUE_ENABLED=true
# Number of recent bot messages to track for unique emoji enforcement (default: 5)
EMOJI_UNIQUE_LOOKBACK=5
# Minimum shared prefix length (after normalization) required to merge adjacent custom emojis
# Example: JoeCaught_1 + JoeCaught_2 merge when set to 3; unrelated emojis stay separate
EMOJI_RUN_PREFIX_LENGTH=3
# Keep false for strict cleanup: unknown :name: emoji attempts are stripped instead of sent literally.
# Set true only if you want unresolved emoji shortcodes to appear as plain Discord text.
EMOJI_PRESERVE_UNRESOLVED_SHORTCODES=false

# Monitoring Configuration (Optional - for Grafana)
GRAFANA_PASSWORD=admin

# Application log file output (Optional)
# When set while the bot logs raw JSON (production, or any run without the pino-pretty
# dev transport), every emitted record is mirrored to this newline-delimited JSON (JSONL)
# file in addition to stdout, via an append-only synchronous stream. Production emits
# level >= 50 only (error, metric, rateLimit, fatal). Used on the Azure VM where Azure
# Monitor Agent tails the bind-mounted file; see docs/en/architecture/cloud/azure-application-logs.md.
# Ignored while the development pino-pretty transport is active. Leave blank to disable.
TOMORI_LOG_FILE=

# Matrix Appservice Bridge (Optional - leave all blank to disable the bridge entirely)
# Each persona appears as its own virtual Matrix user (e.g., @_tomori_lilya:yourdomain.com).
# Requires a self-hosted homeserver (Conduit/Synapse) with appservice registration support.
#
# Setup Steps:
# Step 1: Create appservice-registration.yaml (see HOWTO.md or docs/matrix/) with hs_token + as_token
# Step 2: Register the yaml file with your homeserver (add path to conduit.toml, restart)
# Step 3: Fill in the variables below and restart TomoriBot
#
# Token roles:
#   MATRIX_ACCESS_TOKEN = as_token (TomoriBot -> homeserver auth)
#   MATRIX_HS_TOKEN     = hs_token (homeserver -> TomoriBot auth, verified on incoming events)
# e.g., http://localhost:8448 or https://matrix.yourdomain.com
MATRIX_HOMESERVER_URL=
# Appservice token (as_token) from appservice-registration.yaml
MATRIX_ACCESS_TOKEN=
# e.g., @tomoribot:yourdomain.com
MATRIX_BOT_USER_ID=
# Homeserver domain only, e.g., localhost or yourdomain.com
MATRIX_SERVER_NAME=
# Homeserver token (hs_token) from appservice-registration.yaml
MATRIX_HS_TOKEN=
# Optional callback URL embedded in appservice registration.
# Required when Matrix homeserver is on a different host/network than TomoriBot.
# Examples:
#   Local:   http://localhost:9993
#   Remote:  https://matrix-appservice.example.com (https required for non-localhost)
MATRIX_APPSERVICE_PUBLIC_URL=
# HTTP port TomoriBot listens on for incoming events pushed by the homeserver (default: 9993)
MATRIX_APPSERVICE_PORT=9993
# Cache TTL for channel<->room link DB lookups in minutes (default: 5)
MATRIX_LINK_CACHE_TTL_MINUTES=5
# Maximum attachment size in MB to relay in either direction (Matrix->Discord or Discord->Matrix)
# Files larger than this are replaced with a text notice (default: 8 MB)
MATRIX_MAX_ATTACHMENT_MB=8
# Timeout in milliseconds for Matrix media download/upload operations (default: 15000 ms)
MATRIX_MEDIA_TIMEOUT_MS=15000
# Maximum characters per relayed embed text message before chunking (default: 3500)
MATRIX_EMBED_CHUNK_MAX_CHARS=3500

# Random Trigger System
# Maximum number of random triggers allowed per server (default: 10)
RANDOM_TRIGGER_MAX_PER_SERVER=10

# Guild Remote MCP Servers (Optional)
# Maximum retained stdout/stderr characters from a bundled stdio MCP child.
# Included in startup and unexpected-exit diagnostics (default: 8192).
MCP_STDIO_DIAGNOSTIC_MAX_CHARS=8192
# Maximum number of remote MCP servers a guild can register (default: 5)
MAX_MCP_SERVERS_PER_GUILD=5
# How long idle guild MCP connections stay alive before eviction in minutes (default: 10)
GUILD_MCP_CONNECTION_TTL_MINUTES=10
# Timeout for initial connection + tool discovery when adding a guild MCP server in ms (default: 15000)
GUILD_MCP_CONNECT_TIMEOUT_MS=15000
# Timeout for individual tool execution calls per guild MCP server in ms (default: 30000)
# Increase if your self-hosted MCP tools are slow to respond.
GUILD_MCP_EXECUTION_TIMEOUT_MS=30000
# Cache TTL for guild MCP config DB lookups in minutes (default: 5)
GUILD_MCP_CONFIG_CACHE_TTL_MINUTES=5
# Circuit breaker: after a guild MCP server fails to connect, how long (ms) it is
# quarantined before being re-dialed (default: 300000 = 5 min). Prevents one
# unreachable server from re-paying the connect timeout on every generation and
# stalling chat. Cleared early on a successful connect or on server removal.
GUILD_MCP_FAILURE_COOLDOWN_MS=300000

# User-Supplied Remote URL Fetching (Optional)
# Maximum redirect hops allowed when Tomori validates or calls a user-supplied custom endpoint.
# Each hop is revalidated and re-resolved before the request is sent. (default: 3)
USER_REMOTE_FETCH_MAX_REDIRECTS=3
# Allow /personal custom-endpoint to register localhost and private IP addresses.
# Disabled by default to prevent Discord users from port-probing services on the bot host.
# Safe to enable on self-hosted instances where all server members are trusted.
# Has no effect when RUN_ENV=production — the blocklist is always enforced there.
ALLOW_PERSONAL_LOCAL_ENDPOINTS=false

# Maximum consecutive follow-up interrupts before messages are queued normally (default: 3)
MAX_FOLLOW_UP_INTERRUPTS=3
# Cooldown in milliseconds before a webhook that errored is retried (default: 600000 = 10 min)
WEBHOOK_ERROR_COOLDOWN_MS=600000
# Overall LLM SDK call timeout in milliseconds (default: 120000). Must exceed the TTFT of the slowest model in use.
STREAM_SDK_CALL_TIMEOUT_MS=120000
# After the SDK call timeout aborts a stalled stream, max time in milliseconds to wait for the abandoned
# stream to settle so any in-flight Discord send is recorded before model-fallback cleanup removes the
# superseded attempt's partial output (default: 5000). Set to 0 to skip the wait.
STREAM_ABANDONED_SETTLE_TIMEOUT_MS=5000
# Global timeout per tool execution in milliseconds (default: 300000 = 5 min). On timeout a failed ToolResult is returned so the model can handle it gracefully.
TOOL_EXECUTION_TIMEOUT_MS=300000
# How long in milliseconds a stashed enhanced-context payload (peeked avatar, GIF keyframes) stays
# retrievable before it is evicted (default: 300000 = 5 min). Payloads are normally consumed within
# the same turn, so this only bounds leftovers from turns that aborted before the context restart.
ENHANCED_CONTEXT_STASH_TTL_MS=300000
# Max number of undrained enhanced-context payloads held at once (default: 16). The oldest is dropped
# when the cap is reached; each payload can be several MB of base64 media.
ENHANCED_CONTEXT_STASH_MAX_ENTRIES=16
# How long in milliseconds a channel lock can be held before it is considered stale and released (default: 180000 = 3 min)
CHANNEL_LOCK_TIMEOUT_MS=180000
# Discord typing refresh cadence in milliseconds while a channel lock is actively generating (default: 8000)
DISCORD_TYPING_KEEPALIVE_INTERVAL_MS=8000
# Maximum width in pixels for rendered markdown table images (default: 1400)
MARKDOWN_TABLE_RENDER_MAX_WIDTH=1400
# Maximum height in pixels for rendered markdown table images before falling back to raw text (default: 5000)
MARKDOWN_TABLE_RENDER_MAX_HEIGHT=5000
# Cache TTL in minutes for original markdown behind rendered table images (default: 120)
MARKDOWN_TABLE_CACHE_TTL_MINUTES=120
# How long the "Show Markdown" button on a rendered table stays interactive before being disabled
# (milliseconds, default: 7200000 = 2 hours, matching MARKDOWN_TABLE_CACHE_TTL_MINUTES)
MARKDOWN_TABLE_BUTTON_TIMEOUT_MS=7200000

# Top.gg Integration (Optional - leave blank to disable server count reporting)
# Obtain your token from https://top.gg/bot/:yourbotid/dashboard/integrations
TOPGG_TOKEN=

# How long fallback-model notice buttons remain interactive before being disabled (milliseconds)
FALLBACK_NOTICE_BUTTON_TIMEOUT_MS=86400000
# How long the "Show Full Memory" expand button on memory-learning embeds remains interactive (milliseconds)
MEMORY_EXPAND_BUTTON_TIMEOUT_MS=86400000
# Characters of memory content shown inline on a memory notice before it is truncated
# and the "Show Full Memory" expand button is attached
MEMORY_NOTICE_PREVIEW_LIMIT=600
# How long the "Show Full Task" expand button on scheduled-task embeds remains interactive (milliseconds)
TASK_EXPAND_BUTTON_TIMEOUT_MS=86400000
# How long the "Import Now" button on /persona generate & /persona create results stays clickable
# (milliseconds; capped below Discord's 15-minute interaction-token window, default 14 minutes)
PERSONA_IMPORT_NOW_BUTTON_TIMEOUT_MS=840000
# Max exact stop strings stored per server
BOT_MAX_STOP_STRINGS_PER_SERVER=40
# Max characters allowed in one configured stop string
BOT_MAX_STOP_STRING_LENGTH=200

# Local TTS / VoiceDesign debugging
# Print full VoiceDesign script and instruct payloads in TomoriBot logs. Keep false unless debugging.
TTS_VOICE_DESIGN_LOG_PAYLOADS=false
# Print full script/instruct payloads in the local Qwen3-TTS wrapper logs. Keep 0 unless debugging.
TOMORI_TTS_LOG_PAYLOADS=0
# Preview character count for local Qwen3-TTS wrapper payload logs.
TOMORI_TTS_LOG_PREVIEW_CHARS=240

# Following channel turns where a successfully used tool remains available in deliberate tool mode
DELIBERATE_TOOL_CONTEXT_TURNS=4

# Official persona preset avatar sync (Optional)
# Enabled by default. Set false only as an operational kill switch.
PRESET_AVATAR_SYNC_ENABLED=true
# Delay between Discord guild-avatar updates to reduce startup rate-limit risk.
PRESET_AVATAR_SYNC_DELAY_MS=3000
# Timeout for each Discord guild-avatar PATCH request.
PRESET_AVATAR_SYNC_API_TIMEOUT_MS=15000
# Maximum avatar baselines to evaluate per startup. 0 means unlimited.
PRESET_AVATAR_SYNC_MAX_PER_RUN=0

# Thinking / reasoning defaults for providers that accept numeric budgets
# Used for mapped Low / Medium / High thinking levels where supported.
THINKING_LEVEL_BUDGET_LOW_TOKENS=1024
THINKING_LEVEL_BUDGET_MEDIUM_TOKENS=4096
THINKING_LEVEL_BUDGET_HIGH_TOKENS=8192

# Tracked media size gate (Optional, dev/CI tooling)
# Per-file byte budget enforced by `bun run check-media-size` (part of `bun run vl`).
# Scans tracked media under src/db/seed/catalog/personas/** and assets/img/**;
# fails if any file exceeds this size. Default 1048576 = 1 MiB.
MEDIA_SIZE_LIMIT_BYTES=1048576
# Long-edge cap (px) `bun run compress-media` downscales to ONLY when a file cannot
# fit MEDIA_SIZE_LIMIT_BYTES via lossless re-encode alone. Files that already fit
# losslessly keep their native resolution. Default 768 (ample for Discord avatars).
MEDIA_MAX_DIMENSION=768
# Quality (1-100) `bun run compress-media` uses when converting release cards under
# .github/release/** to WebP. These are web-viewed showcase art (not gate-scoped);
# already-WebP cards are left untouched. Default 90 (visually near-lossless).
RELEASE_CARD_WEBP_QUALITY=90

# Better Time Awareness (Optional)
# Minimum calendar-day gap before a returning-user reunion note is injected.
# Calendar days use the user's personal timezone, then server timezone, then UTC. Default 7.
TIME_AWARENESS_REUNION_DAYS=7
# How many messages deep the reunion note is injected. Depth 1 sits directly above
# the newest message, where it competes with the user's actual prompt; depth 3 keeps
# it advisory. Default 3.
TIME_AWARENESS_NOTE_DEPTH=3
# Safety expiry for a process-local cross-channel reunion claim. Successful and
# failed turns normally release it immediately. Default 240000 (4 minutes).
TIME_AWARENESS_REUNION_CLAIM_TTL_MS=240000

# Usage stat tracking (Optional)
# Pre-aggregated daily usage counters (stat_counters table). Increments are
# buffered in memory and flushed periodically / on graceful shutdown, so a hard
# crash loses only the unflushed buffer (acceptable for aggregate telemetry).
# Master kill switch for the write side. Set false to stop recording stats.
STAT_TRACKING_ENABLED=true
# Interval (ms) between automatic buffer flushes. Default 5000.
STAT_FLUSH_INTERVAL_MS=5000
# Buffer entry count that forces an immediate flush before the next interval.
# Each entry is one distinct (server, user, persona, metric, key, day) tuple.
# Default 1000.
STAT_FLUSH_MAX_BUFFER=1000
# How long (ms) the public /stats dashboard keeps responding to its tab buttons
# before they are stripped. Default 300000 (5 minutes).
STATS_DASHBOARD_TIMEOUT_MS=300000

# Stats infographic card dimensions and theme (Optional, Phase 3)
# Logical canvas width in pixels. Typography and spacing scale with this value;
# each card type uses a content-aware height to avoid empty space. Default 1080.
STATS_CARD_W=1080
# Theme color overrides. Defaults match the TomoriBot brand palette
# baked into statsInfographic.tsx.
STATS_CARD_THEME_BG=#1d100e
STATS_CARD_THEME_SURFACE=#2c1815
STATS_CARD_THEME_ACCENT=#e7322a

# DB regression harness (Optional)
# These let `bun --env-file=.env.test test tests/regression/db/` use a disposable
# test database without pointing the bot's normal local DB env at it.
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=your_test_password
TEST_POSTGRES_DB=tomodb_test

# Short-term memory customization (Optional, migration 051)
# Hard ceiling on the number of categories a server may define (1-5).
STM_MAX_CATEGORIES=5
# Durable short_term_memories rows untouched for this many days are purged by the STM janitor.
STM_JANITOR_RETENTION_DAYS=90
# While a channel's short-term memory is younger than this, the STM content block is
# injected at STM_FRESH_INJECTION_DEPTH instead of the server's configured depth, so a
# live conversation's memory sits next to the dialogue. Older memories snap back to the
# configured depth so stale content never occupies a "most recent" position.
STM_FRESH_WINDOW_MINUTES=60
# Dialogue depth used while the memory is fresh (0 = tail, N = before the Nth turn up).
# Acts as a ceiling, not an override: a server whose configured depth is already closer
# to the dialogue keeps its own placement.
STM_FRESH_INJECTION_DEPTH=2
