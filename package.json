{
  "name": "tomoribot",
  "version": "0.7.9.9997",
  "description": "Customizable AI Assistant Discord Bot",
  "main": "./src/index.ts",
  "type": "module",
  "scripts": {
    "test": "bun run scripts/checks/runTests.ts",
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "dev": "bun --watch src/index.ts",
    "setup": "bun run scripts/devtools/setup.ts",
    "launch": "bun run scripts/devtools/launch.ts",
    "update": "bun run scripts/devtools/update.ts",
    "watch": "bun build ./src/index.ts --outdir dist --target node --watch",
    "purge-commands": "bun run scripts/devtools/purgeCommands.ts",
    "check-migrations": "bun run scripts/db/check-migrations.ts",
    "migrate": "bun run scripts/db/migrate.ts",
    "migrate:down": "bun run scripts/db/migrate-down.ts",
    "check-seed-catalogs": "bun run scripts/checks/checkSeedCatalogs.ts",
    "nuke-db": "bun run scripts/devtools/nukeDb.ts",
    "backup": "bun run scripts/devtools/backupData.ts --backup",
    "restore-backup": "bun run scripts/devtools/backupData.ts --restore",
    "backup:personas": "bun run scripts/devtools/backupPersonas.ts",
    "lint": "biome check --fix",
    "check": "bunx tsc --noEmit",
    "check-locales": "bun run scripts/checks/checkLocalizationKeys.ts",
    "check-locale-lengths": "bun run scripts/checks/checkLocalizationKeys.ts --strict-lengths",
    "generate-command-reference": "bun run scripts/devtools/generateCommandReference.ts",
    "check-command-reference": "bun run scripts/checks/checkCommandReference.ts",
    "check-schema": "bun run scripts/checks/checkSchemaDrift.ts",
    "list-unused-locales": "bun run scripts/checks/checkLocalizationKeys.ts --list-unused",
    "prune-locales": "bun run scripts/devtools/pruneLocaleKeys.ts",
    "find-stale-translations": "bun run scripts/devtools/findStaleTranslations.ts",
    "check-limits": "bun run scripts/checks/checkDiscordLimits.ts",
    "check-media-size": "bun run scripts/checks/checkMediaSize.ts",
    "check-runtime-imports": "bun run scripts/checks/checkRuntimeImports.ts",
    "check-mock-module-surfaces": "bun run scripts/checks/checkMockModuleSurface.ts",
    "audit-comments": "bun run scripts/checks/checkCommentPolicy.ts --audit",
    "compress-media": "bun run scripts/devtools/compressMedia.ts",
    "audit-keys": "bun run scripts/devtools/auditKeyVersions.ts",
    "audit-sql": "bun run scripts/checks/audit_sql.ts",
    "rotate-keys": "bun run scripts/devtools/rotateAllKeys.ts",
    "setup:tokenizers": "bun run scripts/devtools/downloadTokenizers.ts",
    "//audit": "audit:clean runs bun audit --audit-level=high — only high/critical advisories block the pipeline",
    "audit:clean": "bun run scripts/checks/auditClean.ts",
    "db:lifecycle": "bun scripts/checks/validateLifecycle.ts",
    "knip": "knip --config scripts/knip.json",
    "vl": "bun run scripts/checks/vl.ts"
  },
  "workspaces": [
    "apps/*"
  ],
  "author": "Bredrumb",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@aws-sdk/client-secrets-manager": "^3.1011.0",
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^1.44.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@oevortex/ddg_search": "1.3.0",
    "@openrouter/sdk": "0.1.27",
    "@resvg/resvg-js": "^2.6.2",
    "@smithery/api": "^0.56.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "bing-translate-api": "^4.2.0",
    "discord.js": "14.25.1",
    "dotenv": "^17.3.1",
    "ffmpeg-static": "^5.3.0",
    "gifuct-js": "^2.1.2",
    "google-translate-api-x": "^10.7.2",
    "gpt-tokenizer": "^3.4.0",
    "jszip": "^3.10.1",
    "matrix-appservice-bridge": "^11.2.0",
    "music-metadata": "^11.12.3",
    "pdf-parse": "1.1.4",
    "pino": "^10.3.1",
    "profane-words": "^2.1.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "knip": "^6.30.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/turndown": "^5.0.6",
    "picocolors": "^1.1.1",
    "pino-pretty": "^13.1.3",
    "ts-morph": "^28.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@aws-sdk/xml-builder>fast-xml-parser": "5.7.0",
    "body-parser": ">=2.3.0",
    "body-parser>qs": "6.15.2",
    "express-rate-limit": "^8.6.1",
    "express>qs": "6.15.2",
    "jws": "^3.2.2",
    "lodash": "^4.18.1",
    "minimatch": ">=10.2.3",
    "morgan": "1.11.0",
    "qs": "6.15.2",
    "axios": "^1.18.0",
    "hono": ">=4.12.34",
    "@hono/node-server": ">=2.0.5",
    "undici": "^6.28.0",
    "js-yaml": "^4.3.1",
    "brace-expansion": ">=5.0.9",
    "fast-xml-parser": ">=5.7.0",
    "postcss": ">=8.5.18",
    "nanoid": ">=3.3.17 <4",
    "svgo": "^4.0.2",
    "sharp": "$sharp",
    "ajv": "^8.18.0",
    "form-data": ">=4.0.6",
    "underscore": ">=1.12.1",
    "nedb": "npm:@seald-io/nedb@4.1.2",
    "tough-cookie": ">=4.1.3",
    "follow-redirects": ">=1.16.0",
    "protobufjs": ">=8.6.5",
    "fast-xml-builder": ">=1.1.7",
    "fast-uri": "^3.1.5",
    "sanitize-html": ">=2.17.5",
    "esbuild": ">=0.28.1",
    "request": "npm:@cypress/request@^3.0.0",
    "ws": ">=8.20.1"
  },
  "patchedDependencies": {
    "@aws-sdk/xml-builder@3.972.11": "patches/@aws-sdk%2Fxml-builder@3.972.11.patch",
    "@matrix-org/matrix-sdk-crypto-nodejs@0.4.0": "patches/@matrix-org%2Fmatrix-sdk-crypto-nodejs@0.4.0.patch",
    "@sapphire/shapeshift@4.0.0": "patches/@sapphire%2Fshapeshift@4.0.0.patch",
    "starlight-llms-txt@0.11.0": "patches/starlight-llms-txt@0.11.0.patch"
  }
}
